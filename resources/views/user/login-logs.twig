{% extends 'user.base' %}

{% block title %}遊戲登入紀錄{% endblock %}

{% block content %}
  <style>
    @media (max-width: 575.98px) {
      .time-range-group {
        flex-direction: column;
      }
      .time-range-group .time-range-separator {
        width: 100%;
        text-align: center;
        padding: 4px 0;
        background: #f4f6f9;
        border-left: 1px solid #ced4da;
        border-right: 1px solid #ced4da;
      }
      .time-range-group input {
        border-radius: 0.25rem !important;
      }
    }
  </style>

  <!-- 最外層：伺服器篩選列 -->
  <div class="card card-outline card-info mb-3 shadow-sm">
    <div class="card-body py-2 px-3">
      <div class="d-flex align-items-center justify-content-between flex-wrap">
        <div class="d-flex align-items-center my-1 flex-wrap">
          <span class="font-weight-bold mr-3 text-dark">
            <i class="fas fa-server text-info mr-1"></i> 目標伺服器：
          </span>
          <div class="btn-group flex-wrap" role="group" aria-label="伺服器選擇">
            {% for value, name in filterOptions.servers %}
              <button
                type="button"
                class="btn btn-sm mr-2 mb-1 rounded {% if filters.server == value %}btn-primary shadow-sm font-weight-bold{% else %}btn-outline-secondary{% endif %}"
                onclick="changeServer('{{ value }}')"
              >
                <i class="fas fa-cube mr-1"></i> {{ name }}
              </button>
            {% endfor %}
            <button
              type="button"
              class="btn btn-sm mb-1 rounded {% if filters.server == 'all' %}btn-primary shadow-sm font-weight-bold{% else %}btn-outline-secondary{% endif %}"
              onclick="changeServer('all')"
            >
              <i class="fas fa-globe mr-1"></i> 全部伺服器 (跨服查詢)
            </button>
          </div>
        </div>
        <div class="text-muted small my-1">
          {% if filters.server == 'all' %}
            <span class="badge badge-warning text-dark"><i class="fas fa-globe mr-1"></i>跨服模式</span> 查詢全部共用帳號之伺服器
          {% else %}
            <span class="badge badge-success"><i class="fas fa-check-circle mr-1"></i>本服鎖定</span> {{ filterOptions.servers[filters.server] ?? filters.server }}
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <!-- 篩選條件卡片 -->
  <div class="card card-outline card-primary mb-3 shadow-sm">
    <div class="card-header py-2">
      <h3 class="card-title my-1">
        <i class="fas fa-filter text-primary mr-1"></i> 查詢與篩選條件
      </h3>
      <div class="card-tools">
        <button type="button" class="btn btn-tool" data-card-widget="collapse">
          <i class="fas fa-minus"></i>
        </button>
      </div>
    </div>
    <div class="card-body pt-3 pb-2">
      <form id="filterForm" method="GET" action="{{ route('user.login-logs') }}">
        <!-- 保持最外層伺服器設定與右上角排序/每頁筆數 -->
        <input type="hidden" name="server" id="hiddenServer" value="{{ filters.server }}">
        <input type="hidden" name="sort" id="hiddenSort" value="{{ filters.sort }}">
        <input type="hidden" name="per_page" id="hiddenPerPage" value="{{ filters.per_page }}">

        <div class="row align-items-end">
          <!-- 1. 「開始時間」、「結束時間」為一組，置於最前面第一個項目 -->
          <div class="col-lg-6 col-md-12 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1">
              <i class="far fa-calendar-alt text-primary mr-1"></i> 時間範圍 (登入時間)
            </label>
            <div class="input-group time-range-group">
              <input
                type="datetime-local"
                class="form-control"
                id="filterStartTime"
                name="start_time"
                value="{{ filters.start_time }}"
                title="開始時間"
                placeholder="開始時間"
              >
              <div class="input-group-prepend input-group-append time-range-separator">
                <span class="input-group-text px-3 bg-light text-muted font-weight-bold border-0">至</span>
              </div>
              <input
                type="datetime-local"
                class="form-control"
                id="filterEndTime"
                name="end_time"
                value="{{ filters.end_time }}"
                title="結束時間"
                placeholder="結束時間"
              >
            </div>
          </div>

          <!-- 2. 角色名 -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1" for="filterUsername">角色名</label>
            <select class="form-control" id="filterUsername" name="username">
              <option value="all" {% if filters.username == 'all' %}selected{% endif %}>全部角色</option>
              {% for uname in filterOptions.usernames %}
                <option value="{{ uname }}" {% if filters.username == uname %}selected{% endif %}>{{ uname }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- 3. 登入方式 -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1" for="filterLoginMethod">登入方式</label>
            <select class="form-control" id="filterLoginMethod" name="login_method">
              <option value="all" {% if filters.login_method == 'all' %}selected{% endif %}>全部登入方式</option>
              {% for method in filterOptions.loginMethods %}
                <option value="{{ method }}" {% if filters.login_method == method %}selected{% endif %}>
                  {{ filterOptions.methodLabels[method] ?? method }}
                </option>
              {% endfor %}
            </select>
          </div>

          <!-- 4. 連線方式 -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1" for="filterConnectionChannel">連線方式</label>
            <select class="form-control" id="filterConnectionChannel" name="connection_channel">
              <option value="all" {% if filters.connection_channel == 'all' %}selected{% endif %}>全部連線方式</option>
              {% for channel in filterOptions.connectionChannels %}
                <option value="{{ channel }}" {% if filters.connection_channel == channel %}selected{% endif %}>{{ channel }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- 5. 登入 IP -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1" for="filterIp">登入 IP</label>
            <select class="form-control" id="filterIp" name="ip">
              <option value="all" {% if filters.ip == 'all' %}selected{% endif %}>全部 IP</option>
              {% for ip in filterOptions.ips %}
                <option value="{{ ip }}" {% if filters.ip == ip %}selected{% endif %}>{{ ip }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- 6. UUID -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3">
            <label class="form-label font-weight-bold text-dark mb-1" for="filterUuid">UUID</label>
            <select class="form-control" id="filterUuid" name="uuid">
              <option value="all" {% if filters.uuid == 'all' %}selected{% endif %}>全部 UUID</option>
              {% for u in filterOptions.uuids %}
                <option value="{{ u }}" {% if filters.uuid == u %}selected{% endif %}>{{ u }}</option>
              {% endfor %}
            </select>
          </div>

          <!-- 操作按鈕 -->
          <div class="col-lg-3 col-md-6 col-sm-6 mb-3 d-flex align-items-end">
            <button type="submit" class="btn btn-primary mr-2 px-3 shadow-sm flex-fill">
              <i class="fas fa-search mr-1"></i> 查詢
            </button>
            <a href="{{ route('user.login-logs', {'server': filters.server}) }}" class="btn btn-default px-3 shadow-sm flex-fill" title="重設條件 (保留當前伺服器)">
              <i class="fas fa-undo mr-1"></i> 重設
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- 結果表格卡片 -->
  <div class="card card-outline card-secondary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap py-2">
      <!-- 左側：標題與總筆數 -->
      <h3 class="card-title my-1">
        <i class="fas fa-list mr-1"></i> 登入紀錄清單
        {% if logs.total() is defined %}
          <span class="badge badge-info ml-2 font-weight-normal">{{ logs.total() }} 筆紀錄</span>
        {% endif %}
      </h3>

      <!-- 右側：「排序方式」與「每頁筆數」 -->
      <div class="card-tools d-flex align-items-center my-1 flex-wrap">
        <div class="form-inline">
          <!-- 排序方式 -->
          <label class="mr-1 small font-weight-bold text-muted">
            <i class="fas fa-sort-amount-down-alt mr-1"></i>排序：
          </label>
          <select
            class="form-control form-control-sm mr-3 custom-select custom-select-sm"
            onchange="document.getElementById('hiddenSort').value = this.value; document.getElementById('filterForm').submit();"
          >
            <option value="login_time_desc" {% if filters.sort == 'login_time_desc' %}selected{% endif %}>登入時間：新到舊（預設）</option>
            <option value="login_time_asc" {% if filters.sort == 'login_time_asc' %}selected{% endif %}>登入時間：舊到新</option>
            <option value="duration_desc" {% if filters.sort == 'duration_desc' %}selected{% endif %}>遊戲時間：長到短</option>
            <option value="duration_asc" {% if filters.sort == 'duration_asc' %}selected{% endif %}>遊戲時間：短到長</option>
            <option value="username_asc" {% if filters.sort == 'username_asc' %}selected{% endif %}>角色名稱：A 到 Z</option>
            <option value="username_desc" {% if filters.sort == 'username_desc' %}selected{% endif %}>角色名稱：Z 到 A</option>
          </select>

          <!-- 每頁筆數 -->
          <label class="mr-1 small font-weight-bold text-muted">
            <i class="fas fa-list-ol mr-1"></i>每頁：
          </label>
          <select
            class="form-control form-control-sm custom-select custom-select-sm"
            onchange="document.getElementById('hiddenPerPage').value = this.value; document.getElementById('filterForm').submit();"
          >
            <option value="30" {% if filters.per_page == 30 %}selected{% endif %}>30 筆（預設）</option>
            <option value="60" {% if filters.per_page == 60 %}selected{% endif %}>60 筆</option>
            <option value="120" {% if filters.per_page == 120 %}selected{% endif %}>120 筆</option>
          </select>
        </div>
      </div>
    </div>

    <!-- 電腦版/平板表格 (螢幕 md 以上顯示) -->
    <div class="card-body p-0 d-none d-md-block table-responsive">
      <table class="table table-striped table-hover text-nowrap mb-0">
        <thead class="thead-light">
          <tr>
            <th>角色名</th>
            {% if filters.server == 'all' %}
              <th>伺服器名</th>
            {% endif %}
            <th>登入時間</th>
            <th class="text-right">遊戲時間</th>
            <th>登入 IP</th>
            <th>登入方式</th>
            <th>連線方式</th>
            <th>UUID</th>
          </tr>
        </thead>
        <tbody>
          {% for log in logs %}
            <tr>
              <td>
                <span class="font-weight-bold text-primary">{{ log.username }}</span>
              </td>
              {% if filters.server == 'all' %}
                <td>
                  <span class="badge badge-light border">
                    {{ serverMapping[log.server_name] ?? log.server_name }}
                  </span>
                </td>
              {% endif %}
              <td>{{ log.login_time_formatted }}</td>
              <td class="text-right">
                {% if log.is_online %}
                  <span class="badge badge-secondary">未知</span>
                {% else %}
                  {{ log.play_time }}
                {% endif %}
              </td>
              <td>
                <a
                  href="javascript:void(0);"
                  class="copy-text-link text-body"
                  data-copy="{{ log.ip }}"
                  data-tooltip="點擊複製 IP"
                >
                  <code>{{ log.ip }}</code>
                  <i class="copy-icon far fa-copy text-muted ml-1" style="font-size: 0.85em;"></i>
                </a>
              </td>
              <td>
                <span class="badge {{ log.login_method_badge }}">
                  {{ log.login_method_display }}
                </span>
              </td>
              <td>
                <span class="{{ log.conn_channel_badge_class }}" style="{{ log.conn_channel_style }}">
                  {{ log.conn_channel_display }}
                </span>
              </td>
              <td>
                <a
                  href="javascript:void(0);"
                  class="copy-text-link text-muted font-monospace"
                  data-copy="{{ log.uuid }}"
                  data-tooltip="點擊複製 UUID"
                >
                  <small>{{ log.uuid }}</small>
                  <i class="copy-icon far fa-copy text-muted ml-1" style="font-size: 0.85em;"></i>
                </a>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="{% if filters.server == 'all' %}8{% else %}7{% endif %}" class="text-center py-5 text-muted">
                <i class="fas fa-inbox fa-3x d-block mb-3 text-secondary"></i>
                目前沒有符合條件的登入紀錄
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    <!-- 手機版卡片視圖 (螢幕小於 md 顯示，響應式優化) -->
    <div class="card-body p-0 d-md-none">
      {% for log in logs %}
        <div class="p-3 border-bottom {{ loop.index is even ? 'bg-light' : '' }}">
          <!-- 頂部：角色名與連線方式 -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="font-weight-bold text-primary h6 mb-0">{{ log.username }}</span>
            <span class="{{ log.conn_channel_badge_class }}" style="{{ log.conn_channel_style }}">
              {{ log.conn_channel_display }}
            </span>
          </div>

          <!-- 資訊列表 -->
          <div class="row small text-muted mb-1">
            <div class="col-6 mb-1">
              <i class="far fa-clock mr-1"></i><strong>登入時間：</strong><br>
              <span class="text-dark">{{ log.login_time_formatted }}</span>
            </div>
            <div class="col-6 mb-1 text-right">
              <i class="fas fa-hourglass-half mr-1"></i><strong>遊戲時間：</strong><br>
              {% if log.is_online %}
                <span class="badge badge-secondary">未知</span>
              {% else %}
                <span class="text-dark font-weight-bold">{{ log.play_time }}</span>
              {% endif %}
            </div>
          </div>

          <div class="row small text-muted mb-2">
            <div class="col-6">
              <i class="fas fa-sign-in-alt mr-1"></i><strong>登入方式：</strong><br>
              <span class="badge {{ log.login_method_badge }}">{{ log.login_method_display }}</span>
            </div>
            {% if filters.server == 'all' %}
              <div class="col-6">
                <i class="fas fa-server mr-1"></i><strong>伺服器：</strong><br>
                <span class="badge badge-light border">{{ serverMapping[log.server_name] ?? log.server_name }}</span>
              </div>
            {% endif %}
          </div>

          <!-- IP 與 UUID 點擊複製區 (整合 shared.copy-text) -->
          <div class="small bg-white p-2 rounded border">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <span class="text-muted"><i class="fas fa-network-wired mr-1"></i>登入 IP：</span>
              <a
                href="javascript:void(0);"
                class="copy-text-link text-body"
                data-copy="{{ log.ip }}"
                data-tooltip="點擊複製 IP"
              >
                <code>{{ log.ip }}</code>
                <i class="copy-icon far fa-copy text-muted ml-1"></i>
              </a>
            </div>
            <div class="d-flex justify-content-between align-items-center">
              <span class="text-muted"><i class="fas fa-fingerprint mr-1"></i>UUID：</span>
              <a
                href="javascript:void(0);"
                class="copy-text-link text-muted text-truncate"
                style="max-width: 65%;"
                data-copy="{{ log.uuid }}"
                data-tooltip="點擊複製 UUID"
              >
                <small class="font-monospace">{{ log.uuid }}</small>
                <i class="copy-icon far fa-copy text-muted ml-1"></i>
              </a>
            </div>
          </div>
        </div>
      {% else %}
        <div class="text-center py-5 text-muted">
          <i class="fas fa-inbox fa-3x d-block mb-3 text-secondary"></i>
          目前沒有符合條件的登入紀錄
        </div>
      {% endfor %}
    </div>

    <!-- 表格底部頁碼 -->
    {% if logs.total() > 0 %}
      <div class="card-footer d-flex justify-content-between align-items-center flex-wrap py-2">
        <div class="text-muted small my-1">
          顯示第 {{ logs.firstItem() ?? 0 }} 到 {{ logs.lastItem() ?? 0 }} 筆，共 {{ logs.total() }} 筆
        </div>
        <div class="my-1">
          {{ logs.withQueryString().links()|raw }}
        </div>
      </div>
    {% endif %}
  </div>

  <script>
    function changeServer(serverName) {
      var el = document.getElementById('hiddenServer');
      if (el) {
        el.value = serverName;
        document.getElementById('filterForm').submit();
      } else {
        window.location.href = "{{ route('user.login-logs') }}?server=" + encodeURIComponent(serverName);
      }
    }
  </script>

  {# 引入通用文字複製元件 #}
  {{ include('shared.copy-text', ignore_missing = true) }}
{% endblock %}
