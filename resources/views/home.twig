{% extends 'front.base' %}

{% block body_class %}is-home{% endblock %}

{% block style %}
  <link rel="preload" as="image" href="{{ home_pic_url }}">
  <style>
    .hp-wrapper {
      {% if fixed_bg %}
        background-color: rgba(0, 0, 0, 0);
      {% else %}
        background-image: url('{{ home_pic_url }}');
      {% endif %}
    }
    html {
      scroll-behavior: smooth;
    }
    #announcement {
      scroll-margin-top: 80px;
    }

    /* 伺服器連線卡片樣式（支援桌面雙欄並排與手機垂直結構） */
    .server-ip-container {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      max-width: 380px;
      margin: 0 auto;
      width: 100%;
    }

    @media (min-width: 768px) {
      .server-ip-container {
        flex-direction: row;
        justify-content: center;
        max-width: 760px;
        gap: 1rem;
      }
    }

    .server-ip-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      background: rgba(18, 24, 32, 0.82);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      padding: 0.65rem 0.85rem;
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.4);
      cursor: pointer;
      user-select: none;
      transition: all 0.2s ease-in-out;
      flex: 1 1 0;
      min-width: 0;
    }

    .server-ip-card:hover {
      background: rgba(28, 36, 48, 0.94);
      border-color: rgba(255, 255, 255, 0.45);
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
    }

    .server-ip-card:active {
      transform: translateY(0);
    }

    .server-ip-card.copied {
      border-color: rgba(81, 207, 102, 0.85) !important;
      box-shadow: 0 0 18px rgba(81, 207, 102, 0.45) !important;
    }

    .server-ip-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 0.45rem;
      white-space: nowrap;
    }

    .server-ip-title {
      display: flex;
      align-items: center;
      font-size: 0.95rem;
      font-weight: 500;
      color: #ffffff;
      white-space: nowrap;
    }

    .server-ip-tags {
      display: flex;
      align-items: center;
      white-space: nowrap;
    }

    .server-ip-tags .badge {
      font-size: 78%;
      padding: 0.25em 0.45em;
    }

    .server-ip-body {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      width: 100%;
    }

    .server-ip-code {
      flex: 1 1 auto;
      text-align: center;
      font-family: 'Consolas', 'Courier New', monospace;
      font-weight: 600;
      font-size: 0.92rem;
      padding: 0.25rem 0.45rem;
      border-radius: 6px;
      background: rgba(0, 0, 0, 0.6) !important;
      letter-spacing: 0.5px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .server-ip-primary .server-ip-code {
      color: #51cf66 !important;
      border: 1px solid rgba(81, 207, 102, 0.35);
    }

    .server-ip-cdn .server-ip-code {
      color: #4dabf7 !important;
      border: 1px solid rgba(77, 171, 247, 0.35);
    }

    .server-ip-copy-btn {
      display: inline-flex;
      align-items: center;
      padding: 0.25rem 0.55rem;
      font-size: 0.82rem;
      color: rgba(255, 255, 255, 0.7);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 5px;
      transition: all 0.15s ease;
      white-space: nowrap;
      flex-shrink: 0;
    }

    .server-ip-card:hover .server-ip-copy-btn {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.25);
    }

    @media (max-width: 576px) {
      .server-ip-container {
        max-width: 360px;
      }
      .server-ip-title {
        font-size: 0.9rem;
      }
      .server-ip-code {
        font-size: 0.86rem;
        padding: 0.22rem 0.35rem;
      }
      .server-ip-copy-btn {
        padding: 0.22rem 0.5rem;
        font-size: 0.8rem;
      }
    }
  </style>
{% endblock %}

{% block hero %}
  <div class="hp-wrapper">
    {% if fixed_bg %}
      <div id="fixed-bg" style="background-image: url('{{ home_pic_url }}')"></div>
    {% endif %}

    <div class="container">
      <div class="splash">
        <div class="mb-5">
          <h1 class="splash-head">{{ site_name }}</h1>
          <p class="splash-subhead mb-3">
            {{ site_description }}
          </p>

          <div class="server-status-banner">
            <img src="https://mc8-api.yuaner.tw/banner/" class="img-fluid rounded shadow-sm" alt="伺服器即時狀態" style="max-height: 80px;" onerror="this.parentElement.style.display='none'">
          </div>
        </div>

        <div class="server-ip-badges mb-4">
          <div class="server-ip-container">
            <!-- 主要網址 -->
            <div class="server-ip-card server-ip-primary" role="button" data-copy="mc8.yuaner.tw" title="點擊複製主要連線網址">
              <div class="server-ip-header">
                <div class="server-ip-title">
                  <i class="fas fa-network-wired text-success mr-1"></i>
                  <span class="server-ip-label">主要網址</span>
                </div>
                <div class="server-ip-tags">
                  <span class="badge badge-success">IPv6 / IPv4</span>
                </div>
              </div>
              <div class="server-ip-body">
                <code class="server-ip-code">mc8.yuaner.tw</code>
                <span class="server-ip-copy-btn">
                  <i class="copy-icon fas fa-copy"></i>
                  <span class="copy-text ml-1">複製</span>
                </span>
              </div>
            </div>

            <!-- CDN 網址 -->
            <div class="server-ip-card server-ip-cdn" role="button" data-copy="wss://mc8-ws.yuaner.tw" title="點擊複製 CDN 連線網址">
              <div class="server-ip-header">
                <div class="server-ip-title">
                  <i class="fas fa-globe text-info mr-1"></i>
                  <span class="server-ip-label">CDN 網址</span>
                </div>
                <div class="server-ip-tags">
                  <span class="badge badge-primary mr-1">WebSocket</span>
                  <span class="badge badge-warning">CDN</span>
                </div>
              </div>
              <div class="server-ip-body">
                <code class="server-ip-code code-cdn">wss://mc8-ws.yuaner.tw</code>
                <span class="server-ip-copy-btn">
                  <i class="copy-icon fas fa-copy"></i>
                  <span class="copy-text ml-1">複製</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <ul class="list-inline mb-2">
          <li class="list-inline-item">
            <a href="{{ url('page/download') }}" class="main-button main-button-download">
              <i class="fas fa-download mr-1"></i>客戶端下載
            </a>
          </li>
          <li class="list-inline-item">
            {% if auth_check() %}
              <a href="{{ url('user') }}" class="main-button">
                <i class="fas fa-user-circle mr-1"></i>{{ trans('general.user-center') }}
              </a>
            {% else %}
              <a href="{{ url('auth/register') }}" class="main-button main-button-register">
                <i class="fas fa-user-plus mr-1"></i>{{ trans('general.register') }}
              </a>
            {% endif %}
          </li>
        </ul>

        <div class="account-sync-hint mt-2">
          <div class="hint-pill">
            <i class="fas fa-shield-alt text-warning mr-1"></i>
            <span>在此註冊後的帳號密碼，將會同步連動遊戲內登入（<code>/login</code>）</span>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block content %}

  <div id="important" class="container py-5">
    <div class="row">
      <div class="col-lg-6 mb-4 mb-lg-0">
        <article class="markdown-body p-4 bg-white rounded shadow-sm h-100 border">
          {% apply markdown %}
            ## 🖥️ 主機資訊
            * **名稱**：8服 重度機械症 Mechanomania
            * **類型**：Minecraft Java 版伺服器
            * **遊戲版本**：1.21.1
            * **模組架構**：NeoForge
            * **驗證方式**：正版自動登入 + 離線密碼登入
            * **連線網址**：
                * `mc8.yuaner.tw` <span class="badge badge-success">TCP</span> <span class="badge badge-success">IPv6 / IPv4</span>
                * `wss://mc8-ws.yuaner.tw` <span class="badge badge-primary">WebSocket</span> <span class="badge badge-warning">CDN</span>  <span class="badge badge-success">IPv6 / IPv4</span>
            * **備用連線網址**：
                * `mc8-4.yuaner.tw` <span class="badge badge-success">TCP</span> <span class="badge badge-secondary">IPv4</span>
                * `wss://mc8-play.yuaner.tw` <span class="badge badge-primary">WebSocket</span>  <span class="badge badge-success">IPv6 / IPv4</span>
                * `wss://mc8-play4.yuaner.tw` <span class="badge badge-primary">WebSocket</span> <span class="badge badge-secondary">IPv4</span>
            * **玩家人數**：<span id="mc-live-players">最多20人</span>
          {% endapply %}
          <ul id="mc-live-status-list" class="mb-0" style="display: none; margin-top: -8px;">
            <li><strong>執行狀態</strong>：<span id="mc-live-status-badge">🟢 正常運作中</span></li>
          </ul>
        </article>
      </div>

      <div class="col-lg-6">
        {# 重要公告區塊：連動 Blessing Skin 系統公告 #}
        <article id="announcement" class="markdown-body p-4 bg-white rounded shadow-sm mb-4 border">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h2 class="m-0 border-0 p-0 text-primary">
              <i class="fas fa-bullhorn mr-2"></i>重要公告
            </h2>
            <span class="badge badge-primary px-2 py-1">系統連動</span>
          </div>

          {% if has_announcement %}
            <div class="announcement-content">
              {{ announcement|raw }}
            </div>
          {% else %}
            <div class="text-center text-muted py-4">
              <p class="m-0"><i class="fas fa-bell-slash mr-2 text-black-50"></i>目前沒有公告</p>
            </div>
          {% endif %}
        </article>

        {# 常用連結 #}
        <article class="markdown-body p-4 bg-white rounded shadow-sm border">
          <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
            <h2 class="m-0 border-0 p-0">
              <i class="fas fa-compass mr-2 text-info"></i>常用連結
            </h2>
          </div>
          <ul class="list-unstyled mb-0">
            <li class="mb-2">
              <a href="{{ url('page/commands') }}" class="btn btn-sm btn-outline-primary mr-1">
                <i class="fas fa-terminal mr-1"></i>常用指令手冊
              </a>
              <span class="text-muted small">查看 /login、/tpa、/flan 領地等語法</span>
            </li>
            <li class="mb-2">
              <a href="https://mc8-map.yuaner.tw" target="_blank" class="btn btn-sm btn-outline-success mr-1">
                <i class="fas fa-map-marked-alt mr-1"></i>3D 衛星主地圖
              </a>
              <span class="text-muted small">即時查看玩家位置與領地標記</span>
            </li>
            <li class="mb-2">
              <a href="https://mc8-track.yuaner.tw" target="_blank" class="btn btn-sm btn-outline-info mr-1">
                <i class="fas fa-subway mr-1"></i>軌道配置圖
              </a>
              <span class="text-muted small">全服鐵道路線與站點時刻表</span>
            </li>
            <li class="mb-2">
              <a href="https://mc8-chat.yuaner.tw" target="_blank" class="btn btn-sm btn-outline-warning mr-1">
                <i class="fas fa-comments mr-1"></i>網頁版遊戲聊天室
              </a>
              <span class="badge badge-success">雙向即時連動</span>
            </li>
            <li class="mt-3 pt-2 border-top">
              {% if auth_check() %}
