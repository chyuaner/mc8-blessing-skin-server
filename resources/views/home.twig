                  <i class="fas fa-user mr-1"></i>{{ trans('general.user-center') }}
                </a>
              {% else %}
                <a href="{{ url('auth/register') }}" class="btn btn-sm btn-success">
                  <i class="fas fa-user-plus mr-1"></i>{{ trans('general.register') }}
                </a>
                <small class="text-muted ml-2">※ 遊戲帳號密碼完全同步共用</small>
              {% endif %}
