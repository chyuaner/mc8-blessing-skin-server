<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <link rel="preload" as="image" href="{{ home_pic_url }}">
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    <style>
      .hp-wrapper {
        {% if fixed_bg %}
          background-color: rgba(0, 0, 0, 0);
        {% else %}
          background-image: url('{{ home_pic_url }}');
        {% endif %}
      }
    </style>
    {{ include('assets.home-css', ignore_missing = true) }}
    {% block style %}{% endblock %}
  </head>

  <body class="hold-transition layout-top-nav">
    <div class="hp-wrapper">
      {% if fixed_bg %}
        <div id="fixed-bg" style="background-image: url('{{ home_pic_url }}')"></div>
      {% endif %}

      {% block navbar %}
        {{ include('front.navbar', ignore_missing = true) }}
      {% endblock %}

      {% block hero %}
        <div class="container">
          <div class="splash">
            <h1 class="splash-head">{% block hero_title %}{{ site_name }}{% endblock %}</h1>
            <p class="splash-subhead">
              {% block hero_subtitle %}{{ site_description }}{% endblock %}
            </p>
            {% block hero_actions %}{% endblock %}
          </div>
        </div>
      {% endblock %}
    </div>

    <main class="front-content">
      {% block content %}{% endblock %}
    </main>

    {% block footer %}
      {{ include('front.footer', ignore_missing = true) }}
    {% endblock %}

    <script type="application/json" id="blessing-extra">
      {{ {transparent_navbar: transparent_navbar}|json_encode|raw }}
    </script>
    {{ include('assets.home', ignore_missing = true) }}
    {% block script %}{% endblock %}
    {{ include('shared.foot') }}
  </body>
</html>
