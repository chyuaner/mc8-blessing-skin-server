{% extends 'front.base' %}

{% block title %}{{ page_title ? page_title ~ ' - ' ~ site_name : site_name }}{% endblock %}

{% block content %}
  <div class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg">
        <article class="markdown-body p-4 bg-white rounded shadow-sm">
          {% if markdown_content %}
            {{ markdown_content|markdown }}
          {% elseif markdown_file_name %}
            {{ markdown_file(markdown_file_name) }}
          {% else %}
            {% block page_body %}{% endblock %}
          {% endif %}
        </article>
      </div>
    </div>
  </div>
{% endblock %}
