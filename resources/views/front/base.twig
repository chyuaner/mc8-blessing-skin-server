<!DOCTYPE html>
<html lang="{{ locale }}">
  <head>
    {{ include('shared.head') }}
    <title>{% block title %}{{ site_name }}{% endblock %}</title>
    {{ include('assets.home-css', ignore_missing = true) }}
    {% block style %}{% endblock %}
  </head>

  <body class="hold-transition layout-top-nav {% block body_class %}{% endblock %}">
    {% block navbar %}
      {{ include('front.navbar', ignore_missing = true) }}
    {% endblock %}

    {% block hero %}{% endblock %}

    <main class="front-content">
      {% block content %}{% endblock %}
    </main>

    {% block footer %}
      {{ include('front.footer', ignore_missing = true) }}
    {% endblock %}

    {% block script %}{% endblock %}
    {% for script in scripts %}
      <script{% for attribute, value in script %} {{ attribute }}="{{ value }}"{% endfor %}></script>
    {% endfor %}
    {% if inline_js %}
      <script>
        {{ inline_js|striptags('<div><span><ul><li><p><a><img><i>')|raw }}
      </script>
    {% endif %}
    {{ extra_foot|join('\n')|raw }}
  </body>
</html>
