{% block script %}
  <script>
    (function () {
      // 1. 首頁透明導覽列滾動切換（純原生輕量處理）
      var header = document.querySelector('.navbar');
      var hero = document.querySelector('.hp-wrapper');
      if (header && hero) {
        window.addEventListener('scroll', function () {
          var threshold = Math.max(hero.clientHeight - 80, 50);
          if (window.scrollY >= threshold) {
            header.classList.remove('transparent');
          } else {
            header.classList.add('transparent');
          }
        });
      }

      // 2. 即時狀態與人數查詢
      var statusBox = document.getElementById('mc-live-status-list');
      var playersEl = document.getElementById('mc-live-players');

      fetch('https://mc8-api.yuaner.tw/ping/')
        .then(function (res) {
          if (!res.ok) throw new Error('Network response was not ok');
          return res.json();
        })
        .then(function (data) {
          if (statusBox) statusBox.style.display = 'block';
          var statusEl = document.getElementById('mc-live-status-badge');
          if (data && data.players) {
            if (statusEl) statusEl.textContent = '🟢 正常運作中';
            if (playersEl) playersEl.textContent = (data.players.online || 0) + ' / ' + (data.players.max || 20) + ' 人';
          }
        })
        .catch(function () {
          if (statusBox) statusBox.style.display = 'block';
          var statusEl = document.getElementById('mc-live-status-badge');
          if (statusEl) statusEl.textContent = '🔴 伺服器離線 / 維護中';
        });

      // 3. 點選複製網址功能
      function copyText(text, cardEl) {
        function onSuccess() {
          var icon = cardEl.querySelector('.copy-icon');
          var textEl = cardEl.querySelector('.copy-text');
          if (icon) icon.className = 'copy-icon fas fa-check text-success';
          if (textEl) {
            textEl.textContent = '已複製';
            textEl.className = 'copy-text ml-1 text-success';
          }
          cardEl.classList.add('copied');

          setTimeout(function () {
            if (icon) icon.className = 'copy-icon fas fa-copy';
            if (textEl) {
              textEl.textContent = '複製';
              textEl.className = 'copy-text ml-1';
            }
            cardEl.classList.remove('copied');
          }, 1500);
        }

        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(text).then(onSuccess, fallback);
        } else {
          fallback();
        }

        function fallback() {
          var input = document.createElement('textarea');
          input.value = text;
          input.style.position = 'fixed';
          input.style.left = '-9999px';
          document.body.appendChild(input);
          input.focus();
          input.select();
          try {
            document.execCommand('copy');
            onSuccess();
          } catch (e) {
            console.error('複製失敗', e);
          }
          document.body.removeChild(input);
        }
      }

      var copyCards = document.querySelectorAll('.server-ip-card');
      for (var i = 0; i < copyCards.length; i++) {
        copyCards[i].addEventListener('click', function () {
          var text = this.getAttribute('data-copy');
          if (text) {
            copyText(text, this);
          }
        });
      }
    })();
  </script>
{% endblock %}
