{% extends 'front.base' %}

{% block body_class %}is-home{% endblock %}

{% block style %}
  <link rel="preload" as="image" href="{{ home_pic_url }}">
  <style>
    .hp-wrapper {
      {% if fixed_bg %}
        background-color: rgba(0, 0, 0, 0);
      {% else %}
        background-image: url('{{ home_pic_url }}');
      {% endif %}
    }
  </style>
{% endblock %}

{% block hero %}
  <div class="hp-wrapper">
    {% if fixed_bg %}
      <div id="fixed-bg" style="background-image: url('{{ home_pic_url }}')"></div>
    {% endif %}

    <div class="container">
      <div class="splash">
        <h1 class="splash-head">{{ site_name }}</h1>
        <p class="splash-subhead">
          {{ site_description }}
        </p>
        <p>
          <img src="https://mc8-api.yuaner.tw/banner/mc8">
        </p>
        <p>
          <ul>
            <li class="splash-subhead">主要網址 <span class="badge badge-success">IPv6/IPv4</span>：mc8.yuaner.tw</li>
            <li class="splash-subhead">備用網址 <span class="badge badge-dark">IPv4</span>：mc8-4.yuaner.tw</li>
          </ul>
        </p>
        <ul class="list-inline mb-0">
          <li class="list-inline-item">
            <a href="https://file.yuaner.tw/sharing/Hg7WHmcsr" class="main-button">
              客戶端下載
            </a>
          </li>
          <li class="list-inline-item">
            {% if auth_check() %}
              <a href="{{ url('user') }}" class="main-button">
                {{ trans('general.user-center') }}
              </a>
            {% else %}
              <a href="{{ url('auth/register') }}" class="main-button">
                {{ trans('general.register') }}
              </a>
            {% endif %}
          </li>
        </ul>
      </div>
    </div>
  </div>
{% endblock %}

{% block content %}

  <div id="important" class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-6">
        <article class="markdown-body p-4 bg-white rounded shadow-sm">
          {% apply markdown %}
            ## 主機資訊
            * 名稱： 8服 重度機械症 Mechanomania
            * 類型：MC Java 版伺服器
            * 遊戲版本：1.21.1
            * 模組服：Neoforge
            * 種子碼：
            * 驗證方式：正版自動登入 + 離線密碼登入
            * 執行狀態：執行中
            * 玩家數：0 / 20
          {% endapply %}
        </article>
      </div>

      <div class="col-lg-6">
        <article class="markdown-body p-4 bg-white rounded shadow-sm">
          <h2>重要公告</h2>
        </article>
        <article class="markdown-body p-4 bg-white rounded shadow-sm">
          <h2>常用連結</h2>
          {% apply markdown %}
          * [常用指令]({{ url('page/commands') }})
          * [主地圖](https://mc8-map.yuaner.tw)
          * [軌道配置圖](https://mc8-track.yuaner.tw)
          * [網頁版遊戲內聊天室](https://mc8-chat.yuaner.tw)
          {% if auth_check() %}
           <li><a href="{{ url('user') }}">
              {{ trans('general.user-center') }}
              </a></li>
          {% else %}
            <li><a href="{{ url('auth/register') }}">
              {{ trans('general.register') }}
           </a></li>
          {% endif %}
          {% endapply %}
        </article>
      </div>
    </div>
  </div>

  {% if not hide_intro %}
    <div id="intro">
      <div class="container">
        <div class="text-center">
          <h1>{{ trans('index.features.title') }}</h1>
          <br>
          <br>
          <div class="container-lg">
            <div class="row">
              {% for item in ['first', 'second', 'third'] %}
                <div class="col-lg">
                  <i class="fas {{ trans("index.features.#{item}.icon") }} mb-3" aria-hidden="true"></i>
                  <h3>{{ trans("index.features.#{item}.name") }}</h3>
                  <p>{{ trans("index.features.#{item}.desc")|raw }}</p>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
        <br>
      </div>
    </div>
  {% endif %}

  {# 外層容器結構由 home.twig 自行管理，方便彈性排版 #}
  <div id="home-content" class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg">
        <article class="markdown-body p-4 bg-white rounded shadow-sm">
          {# 支援方式一：直接在 Twig HTML 內混合撰寫 Markdown 內容 #}
          {% apply markdown %}
            ## 伺服器公告 (Twig 內嵌 Markdown 範例)
            您可以在此直接以 **Markdown 語法** 與外層 **Bootstrap HTML 結構** 混合編修，排版自由度更高！
          {% endapply %}

          <hr>

          {# 支援方式二：載入獨立 .md 檔案（markdown_file 僅輸出內層純內容，不干預外層 container） #}
          {{ markdown_file('home.md') }}
        </article>
      </div>
    </div>
  </div>
{% endblock %}
